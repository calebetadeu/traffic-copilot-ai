# Ambiente e Segredo
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_system_user_access_token
META_AD_ACCOUNT_ID=act_your_account_id

# Trava de Seguranca Global
MAX_DAILY_BUDGET_PER_ADSET=50.00
DEFAULT_STOP_LOSS_MULTIPLIER=1.0

# Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=traffic-copilot

# Database
DATABASE_URL=sqlite:///./traffic_copilot.db
